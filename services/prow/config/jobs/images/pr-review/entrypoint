#!/usr/bin/env python3

import os
import re
import sys
import requests

repo_owner = os.environ.get("REPO_OWNER", "linuxdeepin")
repo_name = os.environ.get("REPO_NAME", "dtk")
pr_number = os.environ.get("PULL_NUMBER", "1")
pull_sha = os.environ.get("PULL_PULL_SHA", "")
github_token = os.environ.get("GITHUB_TOKEN")
codegeex_token = os.environ.get("CODEGEEX_TOKEN")
codegeex_taskid = os.environ.get("CODEGEEX_TASKID")
dify_url = os.environ.get("DIFY_URL", "http://zl.uniontech.com:8220/trigger")
dify_api_key = os.environ.get("DIFY_API_KEY")
dify_user = os.environ.get("DIFY_USER", "admin")

if not github_token:
    print("请设置环境变量 GITHUB_TOKEN")
    sys.exit(1)

if not dify_url:
    print("请设置环境变量 DIFY_URL")
    sys.exit(1)

if not dify_api_key:
    print("请设置环境变量 DIFY_API_KEY")
    sys.exit(1)

if not dify_user:
    print("请设置环境变量 DIFY_USER")
    sys.exit(1)

try:
    headers = {"Authorization": f"token {github_token}"}

    # 构造PR分析地址
    pr_url = f"https://github.com/{repo_owner}/{repo_name}/pull/{pr_number}"

    # 调用AI审核接口
    ai_review_data = {
        "params": {
            "分析地址": pr_url
        }
    }

    review_response = requests.post(
        dify_url,
        auth=(dify_user, dify_api_key),
        json=ai_review_data
    )
    if not review_response.ok:
        raise Exception("AI审核请求失败: " + review_response.text)

    review_result = review_response.json().get("report", "")
    if not review_result:
        raise Exception("AI审核结果为空")

    # 获取现有的评论列表
    url = f'https://api.github.com/repos/{repo_owner}/{repo_name}/issues/{pr_number}/comments'
    response = requests.get(url, headers=headers)
    if not response.ok:
        raise Exception("pr评论获取失败: " + response.text)
    comments = response.json()

    # 查找是否已存在包含"deepin pr auto review"的评论
    existing_comment = None
    for comment in comments:
        if "deepin pr auto review" in comment['body'].lower():
            existing_comment = comment
            break

    # 如果找到了现有评论，则删除旧评论；否则创建新评论
    comment_body = "### deepin pr auto review\n\n" + review_result
    if existing_comment:
        comment_id = existing_comment['id']
        comment_url = f'https://api.github.com/repos/{repo_owner}/{repo_name}/issues/comments/{comment_id}'
        response = requests.delete(comment_url, headers=headers)
        if not response.ok:
            raise Exception("pr评论删除失败: " + response.text)

    response = requests.post(url, json={'body': comment_body}, headers=headers)
    if not response.ok:
        raise Exception("pr评论提交失败: " + response.text)

    # 解析评分
    score_match = re.search(r"★\s*总体评分\s*[:：]\s*(\d+)\s*分", review_result)
    if score_match:
        score = int(score_match.group(1))
        status_context = "deepin-pr-review"
        status_description = f"总体评分：{score}分"

        if score < 70:
            status_state = "failure"
            status_description += " - 评分低于70分，PR被拦截，请根据 review 建议修改后重试"
            print(f"\n✖ PR 审查不通过，评分 {score} 分，低于 70 分")
            print(f"   拦截原因：{status_description}")
            if pull_sha:
                status_url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/statuses/{pull_sha}"
                status_data = {
                    "state": status_state,
                    "description": status_description,
                    "context": status_context,
                }
                status_resp = requests.post(status_url, json=status_data, headers=headers)
                if not status_resp.ok:
                    print(f"   警告：设置commit状态失败: {status_resp.text}")
            sys.exit(1)
        else:
            status_state = "success"
            status_description += " - 通过"
            print(f"\n✓ PR 审查通过，评分 {score} 分")
            if pull_sha:
                status_url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/statuses/{pull_sha}"
                status_data = {
                    "state": status_state,
                    "description": status_description,
                    "context": status_context,
                }
                requests.post(status_url, json=status_data, headers=headers)
    else:
        print("\n⚠ 未从 review 结果中解析到评分，跳过评分检查")
except Exception as e:
    print(e)
